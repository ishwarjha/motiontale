# Motiontale settings. Copy to your workspace (the folder with kit/) as .env and fill in what you use.
# Values already exported in your shell win over this file. Check what is active: film.py doctor
# Never commit .env.

# --- Agents: Claude Code and Codex use your local logins ------------------------------------
# Sign in once with `claude auth login` and `codex login`. The engine never reads an agent API key;
# on a machine with no login, export ANTHROPIC_API_KEY / OPENAI_API_KEY in the shell that runs the agent.
# Don't export them where you're logged in: the agent would bill the key instead of your subscription.

# --- Voice: only for `voice.py cut --tts`. A human recording is the default and needs none -----
# google | microsoft | elevenlabs. One film can override it in vo/voice.json {"provider": ...}.
VOICE_PROVIDER=google

# Google: Gemini TTS. An API key from your Google AI account.
GEMINI_API_KEY=
GEMINI_TTS_VOICE=Charon
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Microsoft: Azure AI Speech. Key and region from your Speech resource in the Azure portal.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_TTS_VOICE=en-US-AndrewNeural

# ElevenLabs. Key from your profile; voice ID from the Voice Library.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Workspace ----------------------------------------------------------------------------------
# The kit folder (the one holding AUDIO.md and audio/), if it isn't a kit/ folder above your films.
MOTION_KIT=
