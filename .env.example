# Motiontale settings
#
# 1. Copy this file into your workspace (the folder that holds kit/) and rename the copy to .env
#    (keep this original: the plugin reads it to know which settings are allowed)
# 2. Add the keys you use. Every line is optional; a human voice recording needs no keys at all.
# 3. Check what is active, without printing any key:  .venv/bin/python <plugin>/engine/film.py doctor
#
# A value already exported in your shell wins over this file. Never commit .env (it is in .gitignore).


# ==== AI agents: Claude Code and Codex =========================================================
# Sign in once and nothing goes in this file:
#   Claude Code:  claude auth login
#   Codex:        codex login
#
# On a machine where you can't sign in (a server, CI), use an API key instead. Set it in the shell
# that starts the agent, not in this file: Motiontale never loads agent keys from .env.
#   Claude Code:  export ANTHROPIC_API_KEY=...            (key from console.anthropic.com, API keys)
#   Codex:        printenv OPENAI_API_KEY | codex login --with-api-key
#                                                         (key from platform.openai.com, API keys)
# Don't export an API key where you are signed in: the agent would bill the key instead of your plan.


# ==== AI voice (optional) ======================================================================
# Used only by `voice.py cut <video> --tts`. Pick one provider and fill in its keys below.
# One video can use a different provider or voice in its vo/voice.json: {"provider": "...", "voice": "..."}
VOICE_PROVIDER=google            # google | microsoft | elevenlabs

# --- Google (Gemini text-to-speech) ---
# Get a key: aistudio.google.com, then "Get API key", then "Create API key".
GEMINI_API_KEY=
GEMINI_TTS_VOICE=Charon          # a prebuilt Gemini voice, e.g. Charon, Kore, Puck, Aoede, Fenrir
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# --- Microsoft (Azure AI Speech) ---
# Get a key: in the Azure portal, create a "Speech" resource, open it, then "Keys and Endpoint".
# Copy KEY 1 and the Location/Region (letters and digits only, e.g. westeurope or eastus).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_TTS_VOICE=en-US-AndrewNeural   # any neural voice name from the Speech voice gallery

# --- ElevenLabs ---
# Get a key: elevenlabs.io, sign in, then "Developers" in the sidebar, then "API Keys", then create one.
# Voice ID: "My Voices", the voice's "More actions" (three dots), then "Copy voice ID".
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2


# ==== Workspace (optional) =====================================================================
# Where the sound library is, if it isn't a kit/ folder at or above your videos.
# Point it at the kit folder itself (the one holding AUDIO.md and audio/).
MOTION_KIT=
